{
	"name": "cutenode.io",
	"version": "0.0.1",
	"private": true,
	"description": "cutenode's website: cute lil' node projects, one card each.",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:e2e && pnpm test:lighthouse",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "oxlint --type-aware",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "pnpm build && playwright test",
		"test:lighthouse": "pnpm build && lhci autorun",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"deploy": "railway up --detach",
		"serve": "sh scripts/serve.sh"
	},
	"dependencies": {
		"@fontsource-variable/anybody": "^5.3.0",
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@lucide/svelte": "^1.73.0",
		"evlog": "^2.35.1",
		"gray-matter": "^4.0.3",
		"marked": "^18.2.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@lhci/cli": "^0.16.1",
		"@playwright/test": "^1.60.0",
		"@storybook/addon-a11y": "^10.6.7",
		"@storybook/addon-docs": "^10.6.7",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/addon-vitest": "^10.6.7",
		"@storybook/sveltekit": "^10.6.7",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.1.0",
		"@vitest/coverage-v8": "^5.1.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"playwright": "^1.60.0",
		"railway": "3.17.0",
		"storybook": "^10.6.7",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@12.6.0"
}
