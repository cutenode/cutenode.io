{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "import", "vitest", "promise"],
	"options": {
		"reportUnusedDisableDirectives": "error"
	},
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"env": {
		"browser": true,
		"node": true,
		"es2024": true
	},
	"ignorePatterns": [
		"build/**",
		"coverage/**",
		"node_modules/**",
		".svelte-kit/**",
		"storybook-static/**",
		".lighthouseci/**"
	],
	"rules": {
		"no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }],
		"eqeqeq": ["error", "always", { "null": "ignore" }],
		"no-console": "error",
		"no-underscore-dangle": ["warn", { "allow": ["__BUILT_AT__"] }],
		"no-var": "error",
		"prefer-const": "error",
		"typescript/consistent-type-imports": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-non-null-assertion": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-misused-promises": "error",
		"import/no-cycle": "error",
		"import/no-duplicates": "error",
		"unicorn/prefer-node-protocol": "error",
		"unicorn/no-array-for-each": "off",
		"unicorn/consistent-function-scoping": "off",
		"import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "@fontsource-variable/*"] }]
	},
	"overrides": [
		{
			"files": ["**/*.test.ts"],
			"rules": { "typescript/no-unsafe-type-assertion": "off" }
		},
		{
			"files": ["src/app.d.ts"],
			"rules": { "unicorn/require-module-specifiers": "off" }
		}
	]
}
